# --- FINANCIAL DATA & PII: never commit -------------------------------------
# Real statements, exports and the database contain card/account numbers, names
# and addresses. Keep everything real out of git; only anonymised fixtures belong.
*.db
*.db-journal
*.sqlite
*.sqlite3
finance.db

# Real source files (statements / exports). Tests use tests/fixtures/ only.
data/
statements/
exports/
*.csv
*.pdf
!tests/fixtures/**/*.csv
!tests/fixtures/**/*.pdf

# Secrets (future Monzo / Open Banking tokens)
.env
.env.*
secrets.*
*.key

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
*.egg-info/
build/
dist/
